# ---- Сервер ----
PORT=3000
NODE_ENV=development

# Секрет для подписи сессионных токенов (обязательно смените в проде)
SESSION_SECRET=change-me-please

# ---- Почта (OTP-коды) ----
# Если SMTP_HOST не задан, коды печатаются в консоль сервера,
# а в dev-режиме возвращаются в ответе API (поле devCode).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="ThePrompt <no-reply@theprompt.local>"

# ---- Администраторы ----
# Список email через запятую — эти пользователи получают роль admin.
# Если список пуст, админом становится первый зарегистрированный пользователь.
ADMIN_EMAILS=

# ---- Публичный адрес приложения ----
# Нужен для правильного redirect_uri у OAuth-провайдеров.
APP_URL=http://localhost:3000

# ---- Вход через сторонние сервисы (OAuth2) ----
# Заполните пару ClientID/Secret для тех провайдеров, что хотите включить.
# Без ключей кнопка остаётся в интерфейсе, но по клику честно сообщает,
# что вход не настроен — ничего не ломается.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# У OpenAI (ChatGPT) и Anthropic (Claude) нет публичного OAuth «Войти через …»
# для сторонних сайтов, поэтому для них переменных здесь нет — кнопки в
# интерфейсе декоративные и объясняют это по клику.

# ---- DeepSeek (Eduardo: вопрос-ответ/тест/код, и POST /api/test-prompt) ----
# Без ключа Eduardo отвечает в демо-режиме: честно помеченный шаблонный
# результат вместо настоящего ответа нейросети — лимиты при этом всё равно
# считаются по-настоящему. POST /api/test-prompt без ключа честно отвечает
# 503 "DeepSeek API не настроен" и ограничен 10 запросами в минуту с одного IP.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# ---- Генерация изображений (пока отключена) ----
# Вкладка «Изображение» в Eduardo сейчас показывает «скоро будет доступно»
# (см. config.eduardo.imageEnabled). Ключ ниже задел на будущее и сейчас
# нигде не используется.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
