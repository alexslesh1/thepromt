# ---- Сервер ----
PORT=3000
NODE_ENV=development

# Секрет для подписи сессионных токенов (обязательно смените в проде)
SESSION_SECRET=change-me-please

# ---- Почта (OTP-коды) ----
# Если SMTP_HOST не задан, коды печатаются в консоль сервера,
# а в dev-режиме возвращаются в ответе API (поле devCode).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="PromptShare <no-reply@promptshare.local>"

# ---- Администраторы ----
# Список email через запятую — эти пользователи получают роль admin.
# Если список пуст, админом становится первый зарегистрированный пользователь.
ADMIN_EMAILS=
